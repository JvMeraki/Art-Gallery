---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="h-auto bg-gray-50 flex items-center">
  <section
    id="home"
    class="relative w-full bg-cover bg-center py-32"
    style="background-image: url('/img/draws/2.webp');"
  >
    <div
      class="absolute inset-0 bg-[url('/img/draws/2.webp')] bg-cover bg-center filter blur-sm opacity-50"
    >
    </div>
    <div
      class="relative max-w-3xl mx-auto bg-[var(--grey)]/20 backdrop-blur-md rounded-2xl px-6 sm:px-8 md:px-10 py-10"
    >
      <div class="container mx-auto text-center text-[var(--brown)]">
        <h1 class="text-6xl font-bold mb-6">{t("header_title")}</h1>
        <p class="text-2xl font-semibold mb-12">
          {t("header_text")}
        </p>
      </div>
    </div>
  </section>
</div>
