---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { languages } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = {
  home: t("nav_home"),
  gallery: t("nav_gallery"),
  pricing: t("nav_pricing"),
  contact: t("nav_contact"),
};
---

<nav class="bg-white border-gray-200 dark:bg-gray-900 fixed top-0 w-full z-50">
  <div
    class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
  >
    <a
      href={`/${lang}`}
      class="flex items-center space-x-3 rtl:space-x-reverse"
    >
      <img src="/img/logo.png" class="h-8" alt="JV Logo" />
      <span
        class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
        >JV_Fearnot</span
      >
    </a>

    <!-- Language & Hamburger -->
    <div
      class="relative flex items-center md:order-2 space-x-1 md:space-x-0 rtl:space-x-reverse"
    >
      <button
        id="language-toggle"
        class="inline-flex items-center font-medium justify-center px-4 py-2 text-sm text-gray-900 dark:text-white rounded-lg cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 transition"
      >
        <img
          src=`/img/flags/${lang === 'en' ? 'us' : lang}.svg`
          class="w-5 h-5 rounded-full me-2"
          alt=`${languages[lang]} Flag`
        />
        {languages[lang]}
      </button>

      <div
        id="language-dropdown"
        class="hidden absolute right-0 top-full mt-2 min-w-max z-50 text-base list-none bg-white divide-y divide-gray-100 rounded-lg shadow-sm dark:bg-gray-700"
      >
        <ul class="py-2 font-medium">
          {
            Object.entries(languages).map(([key, name]) => (
              <li>
                <a
                  href={`/${key}`}
                  class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-600 dark:hover:text-white"
                >
                  <img
                    src={`/img/flags/${key === "en" ? "us" : key}.svg`}
                    class="w-4 h-4 rounded-full me-2"
                    alt={`${name} Flag`}
                  />{" "}
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-toggle"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 17 14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
    </div>

    <!-- Navbar links -->
    <div
      id="mobile-menu"
      class="hidden w-full md:flex md:w-auto md:order-1 transition-all duration-300"
    >
      <ul
        class="flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 md:flex-row md:mt-0 md:border-0 md:bg-white dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700"
      >
        {
          Object.entries(sections).map(([key, value]) => (
            <li>
              <a
                href={`#${key}`}
                class="block py-2 px-3 md:p-0 text-[var(--gold)] rounded-sm hover:bg-gray-100 md:hover:bg-transparent md:hover:text-[var(--gold)] dark:text-white md:dark:hover:text-[var(--gold)] dark:hover:bg-gray-700 md:dark:hover:bg-transparent"
                aria-current="page"
              >
                {value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <script lang="js">
    document.addEventListener("DOMContentLoaded", () => {
      const langBtn = document.getElementById("language-toggle");
      const langMenu = document.getElementById("language-dropdown");

      langBtn.addEventListener("click", () => {
        langMenu.classList.toggle("hidden");
      });

      document.addEventListener("click", (e) => {
        if (!langBtn.contains(e.target) && !langMenu.contains(e.target)) {
          langMenu.classList.add("hidden");
        }
      });

      const mobileBtn = document.getElementById("mobile-toggle");
      const mobileMenu = document.getElementById("mobile-menu");

      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });

      const navLinks = document.querySelectorAll('#mobile-menu a[href^="#"]');
      const sectionsToObserve = document.querySelectorAll("section[id]");
      let mainObserver;

      const initializeObserver = () => {
        if (mainObserver) {
          mainObserver.disconnect();
        }

        const isMobile = window.innerWidth < 768;
        const observerOptions = {
          rootMargin: isMobile ? "-20% 0px -60% 0px" : "-40% 0px -40% 0px",
          threshold: isMobile ? 0.05 : 0.1,
        };

        const observerCallback = (entries) => {
          const activeEntry = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (activeEntry) {
            const activeId = activeEntry.target.getAttribute("id");
            navLinks.forEach((link) => {
              const linkId = link.getAttribute("href")?.substring(1);
              if (linkId === activeId) {
                link.classList.add(
                  "md:text-[var(--gold)]",
                  "dark:md:text-[var(--gold)]"
                );
                link.classList.remove("text-gray-900", "dark:text-white");
              } else {
                link.classList.remove(
                  "md:text-[var(--gold)]",
                  "dark:md:text-[var(--gold)]"
                );
                link.classList.add("text-gray-900", "dark:text-white");
              }
            });
          }
        };

        mainObserver = new IntersectionObserver(
          observerCallback,
          observerOptions
        );
        sectionsToObserve.forEach((section) => {
          mainObserver.observe(section);
        });
      };

      initializeObserver();

      window.addEventListener("resize", () => {
        initializeObserver();
      });
    });
  </script>
</nav>
